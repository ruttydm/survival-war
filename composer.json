{
    "name": "ruttydm/survival-war",
    "description": "Survival War - A browser-based multiplayer strategy game",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Rutger De Maeyer",
            "email": "rutger.demaeyer@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SurvivalWar\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
