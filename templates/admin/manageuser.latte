{layout '../layouts/admin.latte'}

{block content}
	<h2 class="mb-4">User Management</h2>

	{* Display flash message *}
	{if isset($message)}
		<div class="alert alert-{$messageType} alert-dismissible fade show">
			{$message}
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	{/if}

	{* Filters and Search *}
	<div class="card mb-4">
		<div class="card-body">
			<form method="get" class="row g-3">
				<div class="col-md-3">
					<label class="form-label">Filter</label>
					<select name="filter" class="form-select" onchange="this.form.submit()">
						<option value="all" {if $filter === 'all'}selected{/if}>All Users</option>
						<option value="unverified" {if $filter === 'unverified'}selected{/if}>Unverified</option>
						<option value="verified" {if $filter === 'verified'}selected{/if}>Verified</option>
						<option value="alive" {if $filter === 'alive'}selected{/if}>Alive</option>
						<option value="dead" {if $filter === 'dead'}selected{/if}>Dead</option>
					</select>
				</div>
				<div class="col-md-6">
					<label class="form-label">Search</label>
					<input type="text" name="search" class="form-control" placeholder="Username or email..." value="{$search|escapeHtml}">
				</div>
				<div class="col-md-3">
					<label class="form-label">&nbsp;</label>
					<div>
						<button type="submit" class="btn btn-primary">Search</button>
						<a href="manageuser.php" class="btn btn-secondary">Clear</a>
					</div>
				</div>
			</form>
		</div>
	</div>

	{* User count *}
	<p class="text-muted">Showing {count($users)} of {$total} total users</p>

	{* Users table *}
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>ID</th>
					<th>Username</th>
					<th>Email</th>
					<th>Status</th>
					<th>Land</th>
					<th>Honor</th>
					<th>Last Action</th>
					<th>IP</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{if count($users) > 0}
					{foreach $users as $user}
						<tr>
							<td>{$user['ID']}</td>
							<td>
								<strong>{$user['playername']|escapeHtml}</strong>
								{if $user['dead'] == 1}
									<span class="badge bg-secondary ms-1">Dead</span>
								{/if}
							</td>
							<td><small>{$user['email']|escapeHtml}</small></td>
							<td>
								{if $user['validated'] == 1}
									<span class="badge bg-success">Verified</span>
								{else}
									<span class="badge bg-warning text-dark">Unverified</span>
								{/if}
							</td>
							<td>{$user['land']}</td>
							<td>{$user['honor']}</td>
							<td><small>{$user['lastaction']|date:'Y-m-d H:i'}</small></td>
							<td><small class="text-muted">{$user['ip']|escapeHtml}</small></td>
							<td>
								<div class="btn-group btn-group-sm">
									{if $user['validated'] == 0}
										<a href="manageuser.php?action=verify&id={$user['ID']}" 
										   class="btn btn-success" 
										   title="Verify User"
										   onclick="return confirm('Verify user {$user['playername']|escapeHtml}?')">
											✓ Verify
										</a>
									{/if}
									<a href="manageuser.php?action=delete&id={$user['ID']}" 
									   class="btn btn-danger" 
									   title="Delete User"
									   onclick="return confirm('Delete user {$user['playername']|escapeHtml}? This cannot be undone!')">
										🗑 Delete
									</a>
								</div>
							</td>
						</tr>
					{/foreach}
				{else}
					<tr>
						<td colspan="9" class="text-center text-muted py-4">No users found</td>
					</tr>
				{/if}
			</tbody>
		</table>
	</div>

	{* Pagination *}
	{if $totalPages > 1}
		<nav>
			<ul class="pagination justify-content-center">
				{* Previous button *}
				<li class="page-item {if $currentPage <= 1}disabled{/if}">
					<a class="page-link" href="manageuser.php?start={($currentPage - 2) * $perPage}&filter={$filter}&search={$search|escapeUrl}">Previous</a>
				</li>

				{* Page numbers *}
				{for $i = 1; $i <= $totalPages; $i++}
					{if $i == $currentPage || $i == 1 || $i == $totalPages || ($i >= $currentPage - 2 && $i <= $currentPage + 2)}
						<li class="page-item {if $i == $currentPage}active{/if}">
							<a class="page-link" href="manageuser.php?start={($i - 1) * $perPage}&filter={$filter}&search={$search|escapeUrl}">{$i}</a>
						</li>
					{elseif $i == $currentPage - 3 || $i == $currentPage + 3}
						<li class="page-item disabled">
							<span class="page-link">...</span>
						</li>
					{/if}
				{/for}

				{* Next button *}
				<li class="page-item {if $currentPage >= $totalPages}disabled{/if}">
					<a class="page-link" href="manageuser.php?start={$currentPage * $perPage}&filter={$filter}&search={$search|escapeUrl}">Next</a>
				</li>
			</ul>
		</nav>
	{/if}
{/block}
