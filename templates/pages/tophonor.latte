{layout '../layouts/main.latte'}

{block content}
<center>Page:
{foreach $pages as $page}
	<A href='tophonor.php?start={$page['start']}'>{$page['number']}</a>
{/foreach}
</center><center>Players by Rank<br>
<table class='maintable' border='1'><tr class='mainrow'><td>ID#</td><td>Player</td><td>Honor</td></tr>
{foreach $topPlayers as $player}
	<tr><td>{$player['ID']}</td><td>{$player['playername']|escapeHtml}</td><td>{$player['honor']}</td></tr>
{/foreach}
</table>
{/block}
