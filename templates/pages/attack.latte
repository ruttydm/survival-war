{layout '../layouts/main.latte'}

{block content}
	<h2 class="mb-4">Attack Land</h2>

	<div class="card mb-4">
		<div class="card-header">
			Select Player's Land to Attack
		</div>
		<div class="card-body">
			<p>Type the ID# of the player whose land you wish to attack:</p>
			<form action="" method="post">
				<div class="mb-3">
					<input type="text" name="victimid" class="form-control" placeholder="Player ID" required>
				</div>
				<button type="submit" name="submit" class="btn btn-danger">Attack</button>
			</form>
		</div>
	</div>

	{if $resultMessage}
		<div class="card">
			<div class="card-header">
				Result
			</div>
			<div class="card-body">
				{$resultMessage|noescape}
			</div>
		</div>
	{/if}
{/block}
