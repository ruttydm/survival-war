{layout '../layouts/main.latte'}

{block content}
	<h2 class="mb-4">Hunt Animal</h2>

	{if $resultMessage}
		<div class="alert alert-info mb-4">
			{$resultMessage|noescape}
		</div>
	{/if}

	<div class="card">
		<div class="card-header">
			Select Monster to Slay
		</div>
		<div class="card-body">
			<form method="post" action="">
				{foreach $monsters as $index => $monster}
					<div class="d-flex align-items-start mb-4 pb-4 border-bottom">
						<img src="{$monster['image']|escapeHtml}" height="100" class="me-3 rounded">
						<div class="flex-grow-1">
							<div class="form-check">
								<input class="form-check-input" type="radio" name="monstername" value="{$monster['name']|escapeHtml}" id="monster_{$index}" {if $index == 0}checked{/if}>
								<label class="form-check-label" for="monster_{$index}">
									<strong>{$monster['name']|escapeHtml}</strong>
								</label>
							</div>
							<p class="mt-2 mb-0 text-muted">
								<strong>{$monster['chance']|escapeHtml}%</strong> chance | 
								Reward: <strong>{$monster['goldworth']|escapeHtml} gold + skillpoints</strong> | 
								Energy cost: <strong>{$monster['energycost']|escapeHtml}%</strong>
							</p>
						</div>
					</div>
				{/foreach}
				
				<button type="submit" name="submit" class="btn btn-success">Hunt Animal</button>
			</form>
		</div>
	</div>
{/block}
