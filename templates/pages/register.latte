{layout '../layouts/main.latte'}

{block content}
	<h2 class="mb-4">Register</h2>

	{* Display success message with activation link *}
	{if isset($success) && $success}
		<div class="alert alert-success">
			<h4 class="alert-heading">Registration Successful!</h4>
			<p>Welcome to Survival War, <strong>{$playerName}</strong>!</p>
			<hr>
			<p class="mb-0">Your account has been created. Please click the link below to activate your account:</p>
			<div class="mt-3">
				<a href="{$activationUrl}" class="btn btn-success">Activate Account</a>
			</div>
			<hr>
			<p class="small text-muted mb-0">Or copy this link: <code>{$activationUrl}</code></p>
		</div>
	{else}
		{* Display form errors *}
		<div n:if="$form->hasErrors()" class="alert alert-danger">
			<ul class="mb-0">
				<li n:foreach="$form->errors as $error">{$error}</li>
			</ul>
		</div>

		<form n:name="form">
			<div class="mb-3">
				<label n:name="player" class="form-label">Username</label>
				<input n:name="player" class="form-control">
			</div>
			<div class="mb-3">
				<label n:name="password" class="form-label">Password</label>
				<input n:name="password" class="form-control">
			</div>
			<div class="mb-3">
				<label n:name="pass2" class="form-label">Retype Password</label>
				<input n:name="pass2" class="form-control">
			</div>
			<div class="mb-3">
				<label n:name="email" class="form-label">E-mail Address</label>
				<input n:name="email" class="form-control">
			</div>
			<button n:name="send" class="btn btn-primary">Submit</button>
			<a href="login.php" class="btn btn-danger">Cancel</a>
		</form>
	{/if}
{/block}
