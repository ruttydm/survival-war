						<a href="/attack.php" class="list-group-item list-group-item-action">Attack Land</a>
						<a href="/buyarmy.php" class="list-group-item list-group-item-action">Buy Army</a>
						<a href="/buyland.php" class="list-group-item list-group-item-action">Buy Land</a>
						<a href="/buyscience.php" class="list-group-item list-group-item-action">Buy Science</a>
						<a href="/challengeplayer.php" class="list-group-item list-group-item-action">Challenge Player</a>
						<a href="/logs.php" class="list-group-item list-group-item-action">Logs</a>
						<a href="/playerlist.php" class="list-group-item list-group-item-action">Playerlist</a>
						<a href="/slaymonster.php" class="list-group-item list-group-item-action">Hunt Animal</a>
						<a href="/forums/" class="list-group-item list-group-item-action">Forum</a>
