					</div>
					<div class="col-6 col-md-3 col-lg">
						<span class="text-white-50">Off. Army</span><br>
						<span class="badge bg-danger">{$userstats['offarmy']}</span>
					</div>
					<div class="col-6 col-md-3 col-lg">
						<span class="text-white-50">Def. Army</span><br>
						<span class="badge bg-primary">{$userstats['dffarmy']}</span>
					</div>
					<div class="col-6 col-md-3 col-lg">
						<span class="text-white-50">Science</span><br>
						<span class="badge bg-dark border border-light">{$userstats['science']}</span>
