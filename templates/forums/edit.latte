{layout '../layouts/main.latte'}

{block content}
	{if $isLoggedIn}
		{if isset($success)}
			<div class="alert alert-success">
				<h4 class="alert-heading">Success!</h4>
				<p>Message edited successfully.</p>
				<hr>
				<a href="messages.php?ID={$messageID|escapeHtml}" class="btn btn-primary">Go back to Thread</a>
			</div>
		{elseif $showForm}
			<div class="card">
				<div class="card-header">
					<h5 class="mb-0">Edit Message</h5>
				</div>
				<div class="card-body">
					<form action="edit.php" method="post">
						<input type="hidden" name="msgid" value="{$messageID|escapeHtml}">
						
						<div class="mb-3">
							<label class="form-label">Name</label>
							<input type="text" class="form-control" value="{$playername|escapeHtml}" disabled>
						</div>

						<div class="mb-3">
							<label for="themessage" class="form-label">Message</label>
							<textarea class="form-control" id="themessage" name="themessage" rows="10" required>{$messageText|escapeHtml}</textarea>
						</div>

						<button type="submit" name="submit" class="btn btn-primary">Save Changes</button>
						<a href="messages.php?ID={$messageID|escapeHtml}" class="btn btn-secondary">Cancel</a>
					</form>
				</div>
			</div>
		{/if}
	{else}
		<div class="alert alert-warning">
			<h4>Not Logged In</h4>
			<p>You are not logged in.</p>
		</div>
	{/if}
{/block}
